<view class="settings-page">
  <!-- 返回按钮 + 标题 -->
  <view class="back-bar">
    <view class="back-btn" bindtap="onGoBack">
      <text class="back-icon">←</text>
    </view>
    <text class="back-title">店铺设置</text>
    <view class="back-spacer"></view>
  </view>

  <view class="page-header">
    <text class="page-sub">完善店铺信息，吸引更多客户</text>
  </view>

  <!-- 头像 -->
  <view class="form-group">
    <text class="form-label">店铺头像</text>
    <view class="avatar-upload" bindtap="onChooseAvatar">
      <image wx:if="{{form.avatar}}" class="avatar-preview" src="{{form.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <text>🏪</text>
      </view>
      <text class="upload-hint">点击更换头像</text>
    </view>
  </view>

  <!-- 封面 -->
  <view class="form-group">
    <text class="form-label">店铺封面</text>
    <view class="cover-upload" bindtap="onChooseCover">
      <image wx:if="{{form.cover}}" class="cover-preview" src="{{form.cover}}" mode="aspectFill" />
      <text wx:else class="cover-placeholder">+ 上传封面图</text>
    </view>
  </view>

  <!-- 名称 -->
  <view class="form-group">
    <text class="form-label">店铺名称</text>
    <input
      class="form-input"
      value="{{form.name}}"
      data-field="name"
      bindinput="onInput"
      placeholder="请输入店铺名称"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <!-- 简介 -->
  <view class="form-group">
    <text class="form-label">店铺简介</text>
    <textarea
      class="form-textarea"
      value="{{form.description}}"
      data-field="description"
      bindinput="onInput"
      placeholder="请描述你的店铺特色..."
      placeholder-style="color: rgba(255,255,255,0.2)"
      maxlength="-1"
      auto-height
    />
  </view>

  <!-- 联系方式 -->
  <view class="form-divider">
    <text class="divider-text">联系方式</text>
  </view>

  <view class="form-group">
    <text class="form-label">微信号</text>
    <input
      class="form-input"
      value="{{form.wechat}}"
      data-field="wechat"
      bindinput="onInput"
      placeholder="客户可见的微信号"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <view class="form-group">
    <text class="form-label">手机号</text>
    <input
      class="form-input"
      value="{{form.phone}}"
      data-field="phone"
      bindinput="onInput"
      type="number"
      placeholder="客户可见的手机号"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <view class="form-group">
    <text class="form-label">邮箱</text>
    <input
      class="form-input"
      value="{{form.email}}"
      data-field="email"
      bindinput="onInput"
      placeholder="客户可见的邮箱"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <!-- 模型管理 -->
  <view class="form-divider">
    <text class="divider-text">商品管理</text>
  </view>

  <view class="model-header">
    <text class="model-count">共 {{models.length}} 个模型</text>
    <view class="btn-add-model" bindtap="onShowAddModal">
      <text>+ 添加</text>
    </view>
  </view>

  <view class="models-list">
    <view
      wx:for="{{models}}"
      wx:key="id"
      class="model-row"
    >
      <image class="model-thumb" src="{{item.thumbnail}}" mode="aspectFill" lazy-load />
      <view class="model-info">
        <text class="model-name">{{item.name}}</text>
        <text class="model-cat">{{item.category === 'creature' ? '生物' : item.category === 'industrial' ? '工业模具' : item.category === 'toy' ? '玩具' : item.category === 'plant' ? '植物' : '道具'}}</text>
      </view>
      <view class="model-actions">
        <switch
          checked="{{item.listed}}"
          data-id="{{item.id}}"
          bindchange="onToggleModel"
          color="#4ecdc4"
        />
        <view wx:if="{{item.isCustom}}" class="btn-delete" data-id="{{item.id}}" catchtap="onDeleteModel">
          <text>🗑</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{models.length === 0}}">
      <text class="empty-text">暂未添加模型</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="submit-section">
    <button class="btn-save" bindtap="onSave">保存设置</button>
  </view>
</view>

<!-- ─── 添加模型弹窗 ─── -->
<view class="modal-overlay" wx:if="{{showAddModal}}" bindtap="onHideAddModal"></view>
<view class="modal-panel {{showAddModal ? 'modal-show' : ''}}">
  <view class="modal-title">添加新模型</view>

  <scroll-view class="modal-body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 缩略图 -->
    <view class="form-group">
      <text class="form-label">缩略图 <text class="required">*</text></text>
      <view class="modal-thumb-pick" bindtap="onChooseModelThumb">
        <image wx:if="{{newModel.thumbnail}}" class="modal-thumb-img" src="{{newModel.thumbnail}}" mode="aspectFill" />
        <view wx:else class="modal-thumb-place">
          <text>+</text>
          <text class="thumb-hint">点击上传</text>
        </view>
      </view>
    </view>

    <!-- 名称 -->
    <view class="form-group">
      <text class="form-label">模型名称 <text class="required">*</text></text>
      <input
        class="form-input"
        value="{{newModel.name}}"
        data-field="name"
        bindinput="onNewModelInput"
        placeholder="请输入模型名称"
        placeholder-style="color: rgba(255,255,255,0.2)"
      />
    </view>

    <!-- 描述 -->
    <view class="form-group">
      <text class="form-label">描述</text>
      <textarea
        class="form-textarea form-textarea-sm"
        value="{{newModel.description}}"
        data-field="description"
        bindinput="onNewModelInput"
        placeholder="简要描述模型特点..."
        placeholder-style="color: rgba(255,255,255,0.2)"
      />
    </view>

    <!-- 模型链接 -->
    <view class="form-group">
      <text class="form-label">模型文件链接</text>
      <input
        class="form-input"
        value="{{newModel.modelUrl}}"
        data-field="modelUrl"
        bindinput="onNewModelInput"
        placeholder="glTF / GLB 地址（可选）"
        placeholder-style="color: rgba(255,255,255,0.2)"
      />
    </view>

    <!-- 分类 -->
    <view class="form-group">
      <text class="form-label">分类</text>
      <view class="cat-row">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="cat-tag {{newModel.category === item.key ? 'cat-tag-active' : ''}}"
          data-cat="{{item.key}}"
          bindtap="onNewModelCategory"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 标签 -->
    <view class="form-group">
      <text class="form-label">标签（逗号分隔）</text>
      <input
        class="form-input"
        value="{{newModel.tags}}"
        data-field="tags"
        bindinput="onNewModelInput"
        placeholder="例如：科幻, 金属, PBR"
        placeholder-style="color: rgba(255,255,255,0.2)"
      />
    </view>
  </scroll-view>

  <view class="modal-footer">
    <view class="modal-btn modal-btn-cancel" bindtap="onHideAddModal">取消</view>
    <view class="modal-btn modal-btn-confirm" bindtap="onSubmitNewModel">确认添加</view>
  </view>
</view>
