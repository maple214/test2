page {
  background: #0f0c29;
}

.settings-page {
  min-height: 100vh;
  padding: calc(var(--status-bar-height, 44px) + 104rpx) 28rpx 48rpx;
}

/* Back bar — 固定在顶部 */
.back-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: calc(var(--status-bar-height, 44px) + 16rpx) 28rpx 16rpx;
  background: #0f0c29;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.back-icon {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}

.back-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.back-spacer {
  width: 56rpx;
  flex-shrink: 0;
}

/* Header */
.page-header {
  padding: 12rpx 0 32rpx;
  text-align: center;
}

.page-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* Form */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 14rpx;
}

.form-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  color: #ffffff;
}

.form-textarea {
  min-height: 150rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  color: #ffffff;
  width: 100%;
  box-sizing: border-box;
}

/* Avatar */
.avatar-upload {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #3a3a4e;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.upload-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* Cover */
.cover-upload {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.12);
  overflow: hidden;
}

.cover-preview {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.cover-placeholder {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.25);
}

/* Divider */
.form-divider {
  padding: 16rpx 0 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-top: 8rpx;
}

.divider-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* ─── 模型管理 ─── */
.model-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.model-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.btn-add-model {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: rgba(78, 205, 196, 0.15);
  border: 1rpx solid rgba(78, 205, 196, 0.3);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #4ecdc4;
  font-weight: 500;
}

.models-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.model-row {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.model-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: #2a2a3e;
  flex-shrink: 0;
}

.model-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.model-name {
  font-size: 26rpx;
  color: #ffffff;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-cat {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 4rpx;
  display: block;
}

.model-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  opacity: 0.5;
}

.model-row .empty {
  text-align: center;
  padding: 40rpx 0;
}

.model-row .empty .empty-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.25);
}

/* ─── 弹窗 ─── */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 200;
}

.modal-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  background: #1a1a2e;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.modal-show {
  transform: translateY(0);
}

.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  padding: 32rpx 0 20rpx;
}

.modal-body {
  padding: 0 32rpx;
  max-height: 55vh;
}

.modal-body .form-group {
  margin-bottom: 24rpx;
}

.required {
  color: #ff4757;
}

.modal-thumb-pick {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-thumb-img {
  width: 100%;
  height: 100%;
  background: #2a2a3e;
}

.modal-thumb-place {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.25);
}

.thumb-hint {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.form-textarea-sm {
  min-height: 100rpx;
}

/* 分类标签 */
.cat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat-tag {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.15s;
}

.cat-tag-active {
  color: #4ecdc4;
  background: rgba(78, 205, 196, 0.15);
  border-color: rgba(78, 205, 196, 0.3);
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn-cancel {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
}

.modal-btn-confirm {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #1a1a2e;
}

/* Submit */
.submit-section {
  margin-top: 40rpx;
}

.btn-save {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  border-radius: 16rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}
