<view class="profile-page">
  <top-bar title="我的" />
  
  <!-- 用户信息区域（独立区块） -->
  <view class="user-section">
    <view class="user-card">
      <view class="avatar-wrap" bindtap="onChooseAvatar">
        <image wx:if="{{userInfo.avatar}}" class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text>👤</text>
        </view>
      </view>
      <view class="user-info">
        <view class="name-row">
          <text class="user-name">{{userInfo.nickname && userInfo.nickname.length > 6 ? userInfo.nickname.substring(0,6) + '...' : (userInfo.nickname || '未登录')}}</text>
          <text class="merchant-badge" wx:if="{{isMerchant}}">商家</text>
          <text class="edit-icon" bindtap="onEditNickname">✏️</text>
        </view>
        <text class="user-signature" bindtap="onEditSignature">{{userInfo.signature || '点击添加签名'}}</text>
        <text class="user-hint">{{isLoggedIn ? '' : '登录后体验完整功能'}}</text>
      </view>
      <!-- 功能图标 -->
      <view class="side-icons">
        <view class="side-icon" bindtap="onSettings">
          <text>⚙️</text>
        </view>
        <view class="side-icon" bindtap="onContact">
          <text>💬</text>
        </view>
      </view>
    </view>
    
    <!-- 登录按钮区域 -->
    <view class="login-buttons" wx:if="{{!isLoggedIn}}">
      <button class="btn-login" bindtap="onLogin">立即登录</button>
      <button class="btn-guest" bindtap="onGuest">游客体验</button>
    </view>
  </view>

  <!-- 功能菜单区域 -->
  <view class="page-content">
    <view class="menu-section">
      <view
        wx:for="{{menus}}"
        wx:key="key"
        class="menu-item {{(isMerchant && item.key === 'shop') || (!isMerchant && item.key === 'merchant') ? 'menu-item-primary' : ''}}"
        data-key="{{item.key}}"
        bindtap="onMenuTap"
      >
        <text class="menu-icon">{{item.icon}}</text>
        <view class="menu-text">
          <text class="menu-label">{{item.label}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <!-- 退出登录（仅已登录时显示） -->
      <view wx:if="{{isLoggedIn}}" class="menu-item" data-key="logout" bindtap="onMenuTap">
        <text class="menu-icon">🚪</text>
        <view class="menu-text">
          <text class="menu-label">退出登录</text>
          <text class="menu-desc">退出当前账号</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="footer">
      <text class="footer-text">3D模型展示平台 v1.0.0</text>
    </view>

    <!-- 底部留白给tab-bar -->
    <view class="bottom-spacer"></view>
  </view>

  <tab-bar active="profile" />
</view>