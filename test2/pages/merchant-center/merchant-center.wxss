page {
  background: #f5f5f5;
}

.mc-page {
  min-height: 100vh;
}

.page-content {
  padding-top: 180rpx;
  padding-bottom: 120rpx;
}

/* Message List */
.message-list {
  padding: 16rpx 16rpx;
}

.message-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.msg-avatar {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  flex-shrink: 0;
}

.msg-icon {
  font-size: 36rpx;
}

.msg-content {
  flex: 1;
  padding-left: 16rpx;
  position: relative;
}

.msg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.msg-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.msg-time {
  font-size: 22rpx;
  color: #cccccc;
}

.msg-preview {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.msg-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: #ff4757;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-badge text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 600;
}

/* Empty */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.bottom-spacer {
  height: 20rpx;
}
