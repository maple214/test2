<view class="mc-page">
  <top-bar title="消息" />
  <view class="page-content">
    <!-- 消息列表 -->
    <view class="message-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="message-item"
        bindtap="onMessageTap"
        data-id="{{item.id}}"
      >
        <view class="msg-avatar">
          <text class="msg-icon">{{item.icon}}</text>
        </view>
        <view class="msg-content">
          <view class="msg-header">
            <text class="msg-title">{{item.title}}</text>
            <text class="msg-time">{{item.time}}</text>
          </view>
          <text class="msg-preview">{{item.preview}}</text>
          <view class="msg-badge" wx:if="{{item.unread}}">
            <text>{{item.unread}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{messages.length === 0}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无消息</text>
    </view>

    <!-- 底部留白给tab-bar -->
    <view class="bottom-spacer"></view>
  </view>

  <tab-bar active="merchant" />
</view>
