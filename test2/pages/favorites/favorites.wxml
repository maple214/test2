<view class="favorites-page">
  <top-bar title="我的收藏" showBack="{{true}}" />
  <view class="page-content">
    <view class="model-list" wx:if="{{favoriteModels.length > 0}}">
      <view class="model-item" wx:for="{{favoriteModels}}" wx:key="id" bindtap="onModelTap" data-model="{{item}}">
        <image class="model-thumb" src="{{item.thumbnail}}" mode="aspectFill" />
        <view class="model-info">
          <text class="model-name">{{item.name}}</text>
          <text class="model-desc">{{item.description}}</text>
          <view class="model-meta">
            <text class="merchant-name">{{item.merchantName}}</text>
            <text class="category">{{item.categoryText}}</text>
          </view>
        </view>
        <view class="remove-btn" catchtap="onRemoveFavorite" data-id="{{item.id}}">
          <text class="remove-icon">🗑️</text>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:else>
      <text class="empty-icon">⭐</text>
      <text class="empty-text">暂无收藏</text>
      <text class="empty-hint">快去首页收藏喜欢的模型吧</text>
    </view>
  </view>
  
  <view class="bottom-spacer"></view>
</view>