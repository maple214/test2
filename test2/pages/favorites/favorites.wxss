.favorites-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.page-content {
  padding: 16rpx;
  padding-top: calc(var(--status-bar-height, 44px) + 112rpx);
}

.model-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.model-item {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  gap: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.model-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.model-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.model-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.model-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.merchant-name {
  font-size: 22rpx;
  color: #888888;
}

.category {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(78, 205, 196, 0.15);
  border: 1rpx solid rgba(78, 205, 196, 0.25);
  font-size: 20rpx;
  color: #4ecdc4;
}

.remove-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 59, 48, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.remove-btn:active {
  background: rgba(255, 59, 48, 0.2);
}

.remove-icon {
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #888888;
}

.bottom-spacer {
  height: 120rpx;
}