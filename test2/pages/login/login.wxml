<view class="bg-img"></view>

<view class="data-box">
  <view class="top-box">
    <view class="opacity">

      <!-- ────── 返回按钮 ────── -->
      <view class="back-btn" bindtap="onGoBack">
        <text class="back-icon">←</text>
      </view>

      <!-- ────── Logo 区域 ────── -->
      <view class="logo-area">
        <view class="logo-icon">🧊</view>
        <view class="logo-title">3D模型平台</view>
        <view class="logo-sub">探索无限创意</view>
      </view>

      <!-- ────── 登录切换 Tab ────── -->
      <view class="login-tabs">
        <view
          class="tab-item {{activeTab === 'sms' ? 'active' : ''}}"
          bindtap="onSwitchTab"
          data-tab="sms"
        >验证码登录</view>
        <view
          class="tab-item {{activeTab === 'pwd' ? 'active' : ''}}"
          bindtap="onSwitchTab"
          data-tab="pwd"
        >密码登录</view>
      </view>

      <!-- ────── 登录卡片（包含所有内容） ────── -->
      <view class="login-card">

        <!-- ────── 手机号输入（共用） ────── -->
        <view class="input-group">
          <view class="input-icon">📱</view>
          <input
            class="input-field"
            type="number"
            placeholder="请输入手机号"
            maxlength="11"
            value="{{phone}}"
            bindinput="onPhoneInput"
            bindfocus="onInputFocus"
            adjust-position="{{true}}"
          />
        </view>

        <!-- ────── 验证码登录 ────── -->
        <block wx:if="{{activeTab === 'sms'}}">
          <view class="input-group">
            <view class="input-icon">✉️</view>
            <input
              class="input-field"
              type="number"
              placeholder="请输入验证码"
              maxlength="6"
              value="{{code}}"
              bindinput="onCodeInput"
              bindfocus="onInputFocus"
              adjust-position="{{true}}"
            />
            <button
              class="btn-code {{codeDisabled ? 'disabled' : ''}} {{codeSent ? 'sent' : ''}}"
              bindtap="onGetCode"
              disabled="{{codeDisabled || !isPhoneValid || codeSending}}"
            >{{codeText}}</button>
          </view>
        </block>

        <!-- ────── 密码登录 ────── -->
        <block wx:if="{{activeTab === 'pwd'}}">
          <view class="input-group">
            <view class="input-icon">🔑</view>
            <input
              class="input-field"
              password
              placeholder="请输入密码"
              maxlength="20"
              value="{{password}}"
              bindinput="onPasswordInput"
              bindfocus="onInputFocus"
              adjust-position="{{true}}"
            />
          </view>
        </block>

        <!-- ────── 隐私协议 ────── -->
        <view class="privacy-row" bindtap="onTogglePrivacy">
          <view class="privacy-check {{privacyAgreed ? 'checked' : ''}}">
            <text wx:if="{{privacyAgreed}}">✓</text>
          </view>
          <text class="privacy-text">已阅读并同意</text>
          <text class="privacy-link" catchtap="onViewAgreement" data-type="user">《用户协议》</text>
          <text class="privacy-text">和</text>
          <text class="privacy-link" catchtap="onViewAgreement" data-type="privacy">《隐私政策》</text>
        </view>

        <!-- ────── 登录按钮 ────── -->
        <button
          class="btn-login-main"
          bindtap="onLogin"
          disabled="{{!canLogin || isSubmitting}}"
          loading="{{isSubmitting}}"
        >登 录</button>

        <!-- ────── 辅助入口（注册账号、忘记密码） ────── -->
        <view class="aux-links">
          <text class="aux-link" bindtap="onGoRegister">注册账号</text>
          <text class="aux-divider">|</text>
          <text class="aux-link" bindtap="onGoResetPwd">忘记密码</text>
        </view>

        <!-- ────── 微信快捷登录 ────── -->
        <view class="wechat-section">
          <view class="divider-row">
            <view class="divider-line"></view>
            <text class="divider-text">其他登录方式</text>
            <view class="divider-line"></view>
          </view>
          <button class="btn-wechat" bindtap="onWechatLogin">
            <text class="wechat-icon">💬</text>
            <text>微信一键登录</text>
          </button>
        </view>

      </view>

    </view>
  </view>
</view>
