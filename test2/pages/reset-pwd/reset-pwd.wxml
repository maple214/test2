<view class="bg-img"></view>

<view class="data-box">
  <view class="top-box">
    <view class="opacity">

      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="onGoBack">
        <text class="back-icon">←</text>
      </view>

      <view class="logo-area">
      <view class="logo-icon">🔐</view>
      <view class="logo-title">重置密码</view>
      <view class="logo-sub">验证手机号后重置密码</view>
    </view>

    <view class="login-card">

      <!-- 手机号 -->
      <view class="input-group">
        <view class="input-icon">📱</view>
        <input class="input-field" type="number" placeholder="请输入手机号" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" bindfocus="onInputFocus" adjust-position="{{true}}" />
      </view>

      <!-- 验证码 -->
      <view class="input-group">
        <view class="input-icon">✉️</view>
        <input class="input-field" type="number" placeholder="请输入验证码" maxlength="6" value="{{code}}" bindinput="onCodeInput" bindfocus="onInputFocus" adjust-position="{{true}}" />
        <button class="btn-code {{codeDisabled ? 'disabled' : ''}} {{codeSent ? 'sent' : ''}}" bindtap="onGetCode" disabled="{{codeDisabled || !isPhoneValid || codeSending}}">{{codeText}}</button>
      </view>

      <!-- 新密码 -->
      <view class="input-group">
        <view class="input-icon">🔒</view>
        <input class="input-field" password placeholder="设置6-20位新密码" maxlength="20" value="{{password}}" bindinput="onPwdInput" bindfocus="onInputFocus" adjust-position="{{true}}" />
      </view>

      <!-- 确认新密码 -->
      <view class="input-group">
        <view class="input-icon">🔐</view>
        <input class="input-field" password placeholder="再次输入新密码" maxlength="20" value="{{confirmPwd}}" bindinput="onConfirmPwdInput" bindfocus="onInputFocus" adjust-position="{{true}}" />
      </view>

      <!-- 重置按钮 -->
      <button class="btn-login-main" bindtap="onResetPwd" disabled="{{!canSubmit || isSubmitting}}" loading="{{isSubmitting}}">重置密码</button>

      <view class="aux-links">
        <text class="aux-link" bindtap="onGoLogin">返回登录</text>
      </view>

    </view>

    </view>
  </view>
</view>